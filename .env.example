# 백엔드 API 주소. next.config.ts의 /api rewrite 목적지와 서버 컴포넌트의 직접 호출 둘에 쓴다
# next.config.ts가 로드될 때 읽히므로 next build와 next dev, next typegen(pnpm type:check)이 전부 이 값을 요구한다
# 비어 있으면 그 자리에서 멈춘다. lefthook pre-push의 type:check도 같아서 로컬 .env.local에 있어야 한다
# 빌드 시점 변수라 Vercel 프로젝트 환경 변수(Production과 Preview)에도 등록한다. 브라우저 번들에는 들어가지 않는다
API_BASE_URL=https://prod.poppick.shop

# Kakao 개발자 콘솔의 JavaScript 키. 배포 도메인을 콘솔에 등록해야 동작한다
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 카카오 로그인 REST API 키. 카카오 개발자 콘솔(developers.kakao.com)에서 발급받는다
# redirect_uri는 {배포 도메인}/auth/kakao/callback으로 등록한다
NEXT_PUBLIC_KAKAO_CLIENT_ID=
